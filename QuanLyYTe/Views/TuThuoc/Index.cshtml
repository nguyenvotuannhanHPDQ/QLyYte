@model List<QuanLyYTe.Models.ViewModels.TuThuocListView>
@using System.Security.Claims;
@using QuanLyYTe.Repositorys;
@using Microsoft.EntityFrameworkCore;
@inject QuanLyYTe.Repositorys.DataContext _context

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Pager pager = new Pager();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
    string st = ViewBag.st?.ToString("yyyy-MM-dd");
    string ed = ViewBag.ed?.ToString("yyyy-MM-dd"); ;

}
@{
    var TenDangNhap = User.FindFirstValue(ClaimTypes.Name);
    var list = _context.TaiKhoan.Where(x => x.TenDangNhap == TenDangNhap).FirstOrDefault();
}

<div class="wrapper">
    <div class="page-wrap">
        <div class="main-content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div>

                                <div class="card-header">
                                    <div class="row">
                                        
                                    </div>
                                </div>
                                <div style="display: flex;">
                                    <div style="text-align:left;width:89%">
                                        <img style="width: 15%;" src="~/images/logoHP.png">
                                        <div style="text-align: center; width: 14%; font-size: 11px; padding-top:0.5%;">
                                            <b>
                                                CÔNG TY CỔ PHẦN THÉP<br />
                                                HÒA PHÁT DUNG QUẤT
                                            </b>
                                        </div>
                                    </div>

                                    <div>
                                    </div>

                                </div>
                                <div class="app-page-title" style="display: contents;">
                                    <div class="page-title-wrapper" style=" display: contents;">
                                        <div class="page-title-heading">
                                            <div style="text-align:center;">
                                                <h4 style="margin:0px;">
                                                    <b>
                                                        DANH SÁCH TỦ THUỐC BỘ PHẬN/NHÀ MÁY
                                                    </b>
                                                </h4>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive" style="width:84vw;overflow-y: scroll; height: 30vw;">
                                    <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                        <thead class="thead-light">
                                            <tr>
                                                <th class="text-center" width="30px">#</th>
                                                <th>Tên tủ thuốc</th>
                                                <th>Bộ phận/Nhà máy</th>
                                                <th class="text-center" width="200px">Mô tả</th>
                                                <th class="text-center" width="200px">Ngày tạo</th>
                                                <th class="text-center" width="400px">Xem đường đi từ vị trí hiện tại</th>
                                                @{
                                                    if (list != null)
                                                    {
                                                        if (list.ID_Quyen == 1 || list.ID_Quyen == 2)
                                                        {
                                                            <th class="text-center" width="100px">Thao tác</th>
                                                        }
                                                    }
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int pageno = (int)pager.CurrentPage;
                                                int itemperpage = (int)pager.PageSize;
                                                int RowNo = ((pageno - 1) * itemperpage) + 1;
                                            }

                                            @for (int i = 0; i < Model.Count; i++)
                                            {
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td>@Model[i].TenTuThuoc</td>
                                                    <td>@Model[i].TenPhongBan</td>
                                                    <td>@Model[i].GhiChu</td>
                                                    <td>@Model[i].NgayTao</td>
                                                    <td>
                                                        <a href="@Model[i].ChiDuongUrl"
                                                           target="_blank"
                                                           class="btn btn-sm btn-success">
                                                            Xem đường đi
                                                        </a>
                                                    </td>
                                                    @{
                                                        if (list != null)
                                                        {
                                                            if (list.ID_Quyen == 1 || list.ID_Quyen == 2)
                                                            {
                                                                <td class="text-center">
                                                                    <a class="bi bi-trash-fill"
                                                                       title="Xóa"
                                                                       href="@Url.Action("Delete", "TuThuoc", new { id = @Model[i].ID_TuThuoc})"
                                                                       onclick="return confirm('Bạn có chắc muốn xóa tủ thuốc: @Model[i].TenTuThuoc ?')">
                                                                    </a>

                                                                    <a title="Chi tiết"
                                                                       class="feather icon-align-justify"
                                                                       href="@Url.Action("Edit","TuThuoc", new { id = Model[i].ID_TuThuoc })">
                                                                    </a>
                                                                </td>

                                                            }
                                                        }
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <div id="map" style="height:500px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const map = L.map('map').setView([15.37768, 108.793321], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    const markers = [];
    const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    if (Array.isArray(data)) {
        data.forEach(item => {

            if (!item.Latitude || !item.Longitude) return;

            const marker = L.marker([item.Latitude, item.Longitude])
            .addTo(map)
            .bindTooltip(item.TenTuThuoc, {
                permanent: true,
                direction: 'top',
                offset: [0, -10],
                className: 'tu-thuoc-label'
            });

            markers.push(marker);
        });

        if (markers.length > 0) {
            const group = L.featureGroup(markers);
            map.fitBounds(group.getBounds().pad(0.2));
        }
    }
</script>