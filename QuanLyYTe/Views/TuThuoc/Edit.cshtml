@model QuanLyYTe.Models.TuThuoc
@using System.Security.Claims;
@using QuanLyYTe.Repositorys;
@using Microsoft.EntityFrameworkCore;
@inject QuanLyYTe.Repositorys.DataContext _context

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Pager pager = new Pager();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
    string st = ViewBag.st?.ToString("yyyy-MM-dd");
    string ed = ViewBag.ed?.ToString("yyyy-MM-dd"); ;

}
@{
    var TenDangNhap = User.FindFirstValue(ClaimTypes.Name);
    var list = _context.TaiKhoan.Where(x => x.TenDangNhap == TenDangNhap).FirstOrDefault();
}

<div class="wrapper">
    <div class="page-wrap">
        <div class="main-content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div>

                                <div class="card-header">
                                    <div class="row">
                                        
                                    </div>
                                </div>
                                <div style="display: flex;">
                                    <div style="text-align:left;width:89%">
                                        <img style="width: 15%;" src="~/images/logoHP.png">
                                        <div style="text-align: center; width: 14%; font-size: 11px; padding-top:0.5%;">
                                            <b>
                                                CÔNG TY CỔ PHẦN THÉP<br />
                                                HÒA PHÁT DUNG QUẤT
                                            </b>
                                        </div>
                                    </div>

                                    <div>
                                    </div>

                                </div>
                                <div class="app-page-title" style="display: contents;">
                                    <div class="page-title-wrapper" style=" display: contents;">
                                        <div class="page-title-heading">
                                            <div style="text-align:center;">
                                                <h4 style="margin:0px;">
                                                    <b>
                                                        THÊM MỚI VỊ TRÍ TỦ THUỐC
                                                    </b>
                                                </h4>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            @using (Html.BeginForm("Edit", "TuThuoc", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.ID_TuThuoc)

                                <div class="card">
                                    <div class="card-body">

                                        <!-- TÊN TỦ THUỐC -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Tên tủ thuốc *</label>
                                            <input type="text"
                                                   name="TenTuThuoc"
                                                   class="form-control"
                                                   value="@Model.TenTuThuoc"
                                                   required />
                                        </div>

                                        <!-- BỘ PHẬN -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Bộ phận *</label>
                                            <select name="ID_PhongBan" class="form-control" required>
                                                <option value="">-- Chọn bộ phận --</option>
                                                @foreach (var bp in ViewBag.BoPhan)
                                                {
                                                    <!option value="@bp.ID_PhongBan"
                                                            @(bp.ID_PhongBan == Model.ID_PhongBan ? "selected" : "")>
                                                        @bp.TenPhongBan
                                                    </!option>
                                                }
                                            </select>
                                        </div>

                                        <!-- CÁCH CHỌN VỊ TRÍ -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Cách chọn vị trí *</label>
                                            <div>
                                                <input type="radio"
                                                       name="LocationMode"
                                                       id="modeMap"
                                                       value="map"
                                                       @(Model.Latitude != null && Model.Longitude != null ? "checked" : "") />
                                                <label for="modeMap">Chọn trên bản đồ</label>

                                                <input type="radio"
                                                       name="LocationMode"
                                                       id="modeManual"
                                                       value="manual"
                                                       class="ms-3"
                                                       @(Model.Latitude == null || Model.Longitude == null ? "checked" : "") />
                                                <label for="modeManual">Nhập tọa độ</label>
                                            </div>
                                        </div>

                                        <!-- MAP -->
                                        <div class="mb-3" id="mapContainer">
                                            <label class="form-label fw-bold">Chọn vị trí trên bản đồ *</label>
                                            <div id="map" style="height:400px;"></div>

                                            <input type="hidden" id="Latitude" name="Latitude" value="@Model.Latitude" />
                                            <input type="hidden" id="Longitude" name="Longitude" value="@Model.Longitude" />
                                        </div>

                                        <!-- NHẬP TAY -->
                                        <div class="mb-3 d-none" id="manualContainer">
                                            <label class="form-label fw-bold">Nhập tọa độ *</label>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <input type="number"
                                                           step="any"
                                                           id="ManualLatitude"
                                                           class="form-control"
                                                           value="@Model.Latitude"
                                                           placeholder="Latitude (VD: 15.37768)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <input type="number"
                                                           step="any"
                                                           id="ManualLongitude"
                                                           class="form-control"
                                                           value="@Model.Longitude"
                                                           placeholder="Longitude (VD: 108.793321)" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- MÔ TẢ -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Mô tả *</label>
                                            <textarea name="GhiChu"
                                                      class="form-control"
                                                      required>@Model.GhiChu</textarea>
                                        </div>

                                        <div class="text-end">
                                            <button class="btn btn-success">Lưu</button>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const mapContainer = document.getElementById('mapContainer');
    const manualContainer = document.getElementById('manualContainer');

    document.getElementById('modeMap').addEventListener('change', function () {
        mapContainer.classList.remove('d-none');
        manualContainer.classList.add('d-none');
    });

    document.getElementById('modeManual').addEventListener('change', function () {
        mapContainer.classList.add('d-none');
        manualContainer.classList.remove('d-none');
        syncManual();
    });

    document.getElementById('ManualLatitude')?.addEventListener('input', syncManual);
    document.getElementById('ManualLongitude')?.addEventListener('input', syncManual);

    function syncManual() {
        document.getElementById('Latitude').value =
            document.getElementById('ManualLatitude').value;

        document.getElementById('Longitude').value =
            document.getElementById('ManualLongitude').value;
    }
</script>

<script>
    const latValue = document.getElementById("Latitude").value;
    const lngValue = document.getElementById("Longitude").value;
    const tenTuThuoc = document.getElementsByName('TenTuThuoc')[0].value;

    const lat = latValue ? parseFloat(latValue) : 15.37768;
    const lng = lngValue ? parseFloat(lngValue) : 108.793321;

    // Init map
    const map = L.map('map').setView([lat, lng], 16);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    let marker = null;

    if (!isNaN(lat) && !isNaN(lng)) {
        marker = L.marker([lat, lng]).addTo(map)
        .bindTooltip(tenTuThuoc, {
                permanent: true,
                direction: 'top',
                offset: [0, -10],
                className: 'tu-thuoc-label'
        });
    }

    map.on('click', function (e) {
        const clickLat = e.latlng.lat;
        const clickLng = e.latlng.lng;

        document.getElementById("Latitude").value = clickLat;
        document.getElementById("Longitude").value = clickLng;

        if (marker) {
            marker.setLatLng(e.latlng);
        } else {
            marker = L.marker(e.latlng).addTo(map);
        }
    });
</script>